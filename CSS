/* 1. Make the Right Sidebar float on top instead of pushing the chart */
.layout__area--right {
    position: absolute !important;
    right: 0;
    z-index: 10;
    height: 100%;
    /* 2. Make it a 'Ghost' by default */
    opacity: 0.2;
    transition: opacity 0.3s ease;
    background-color: rgba(0, 0, 0, 0.5) !important;
}

/* 3. Bring it to full visibility when you hover over it */
.layout__area--right:hover {
    opacity: 1.0;
    background-color: rgba(0, 0, 0, 0.9) !important;
}

/* 4. Optional: Do the same for the Bottom Panel (Trading Panel) */
.layout__area--bottom {
    opacity: 0.3;
    transition: opacity 0.3s ease;
}
.layout__area--bottom:hover {
    opacity: 1.0;
}
